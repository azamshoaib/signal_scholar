# Copy to .env and adjust if needed. These are also the defaults baked
# into docker-compose.yml and settings.py, so the app works out of the
# box without a .env file for local development.

POSTGRES_DB=signal_scholar
POSTGRES_USER=signal_scholar
POSTGRES_PASSWORD=signal_scholar_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dev default: the built-in "django-insecure-..." value (never used when
# DJANGO_DEBUG=False). A real deployment must set this to a long, random
# value and keep it secret.
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me

# Dev default: True, so local dev works without a .env file. A real
# deployment must explicitly set DJANGO_DEBUG=False.
DJANGO_DEBUG=True

# Dev default: empty (Django already permits localhost/127.0.0.1 while
# DJANGO_DEBUG=True). A real deployment must set this to a comma-separated
# list of its actual domain(s), e.g. example.com,www.example.com.
DJANGO_ALLOWED_HOSTS=
